# Local-dev config for `npm run dev` only. The Terraform console build injects
# the real VITE_* values at deploy time (see eap-platform/console/main.tf),
# so these are placeholders — fill in from `terraform output` for local dev.
# Do NOT commit real deployment IDs here.
VITE_COGNITO_DOMAIN=eap-platform-bu-1-dev
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_CLIENT_ID=
VITE_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_USER_POOL_ID=
VITE_IDENTITY_POOL_ID=
VITE_STATE_TABLE=agent-school-lifecycle-team-bu-1-dev
