# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Terraform lock file (include in version control for consistency)
# .terraform.lock.hcl

# Terraform directory
.terraform/

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive variable files
*.tfvars
*.tfvars.json
!example.tfvars
# Committed deployment presets (placeholders only, no secrets — ADR-034).
!configs/*.tfvars
# ...except the test bed's generated, account-specific resolved preset.
configs/enterprise.testbed.tfvars

# Throwaway Docker config dirs written by the backend image-build provisioners
# (isolate `docker login` from the macOS keychain helper). Never committed.
.docker-ade/
.docker-examples/
.docker-studio-read/

# CLI configuration files
.terraformrc
terraform.rc

# IDE/editor files
.idea/
*.swp
*.swo
*~
.vscode/

# OS files
.DS_Store
Thumbs.db
