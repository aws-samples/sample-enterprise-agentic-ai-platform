# Generated by eap-generate — do not edit manually
# Source: agent.yaml | Domain: {{ domain }} | Agents: {{ agent_names | join(', ') }}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      managed_by = "eap-generate"
      domain     = "{{ domain }}"
      platform   = "eap"
    }
  }
}

data "aws_caller_identity" "current" {}
data "aws_region" "current" {}

locals {
  account_id = data.aws_caller_identity.current.account_id
  region     = data.aws_region.current.id
}

# ---------------------------------------------------------------------------
# Cognito App Clients — one per agent
# ---------------------------------------------------------------------------
{% for agent in agents %}
resource "aws_cognito_user_pool_client" "{{ agent.name }}" {
  name         = "{{ domain }}-{{ agent.name }}"
  user_pool_id = var.cognito_user_pool_id

  generate_secret = true

  allowed_oauth_flows_user_pool_client = true
  allowed_oauth_flows                  = ["client_credentials"]
  allowed_oauth_scopes                 = [var.cognito_a2a_scope]
  supported_identity_providers         = ["COGNITO"]

  explicit_auth_flows = ["ALLOW_REFRESH_TOKEN_AUTH"]
}
{% endfor %}

# ---------------------------------------------------------------------------
# IAM Role — Shared by all agents in this manifest
# ---------------------------------------------------------------------------
data "aws_iam_policy_document" "runtime_assume" {
  statement {
    effect  = "Allow"
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["bedrock-agentcore.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "runtime" {
  name               = "{{ domain }}-agents-runtime-role"
  assume_role_policy = data.aws_iam_policy_document.runtime_assume.json
}

data "aws_iam_policy_document" "runtime_permissions" {
  statement {
    effect    = "Allow"
    actions   = ["ecr:GetAuthorizationToken"]
    resources = ["*"]
  }

  statement {
    effect = "Allow"
    actions = [
      "ecr:BatchGetImage",
      "ecr:GetDownloadUrlForLayer",
    ]
    resources = ["arn:aws:ecr:${local.region}:${local.account_id}:repository/*"]
  }

  statement {
    effect = "Allow"
    actions = [
      "bedrock:InvokeModel",
      "bedrock:InvokeModelWithResponseStream",
    ]
    resources = [
      "arn:aws:bedrock:*::foundation-model/{{ model_id }}",
    ]
  }

  statement {
    effect = "Allow"
    actions = [
      "logs:CreateLogGroup",
      "logs:CreateLogStream",
      "logs:PutLogEvents",
    ]
    resources = ["arn:aws:logs:${local.region}:${local.account_id}:log-group:/eap/{{ domain }}/*"]
  }
}

resource "aws_iam_role_policy" "runtime_permissions" {
  name   = "{{ domain }}-agents-runtime-policy"
  role   = aws_iam_role.runtime.id
  policy = data.aws_iam_policy_document.runtime_permissions.json
}

# ---------------------------------------------------------------------------
# Agent Runtimes (ordered by dependency — callees before callers)
# ---------------------------------------------------------------------------
{% for agent in agents %}
module "runtime_{{ agent.name }}" {
  source = "{{ module_source }}//modules/runtime?ref={{ module_version }}"

  name      = "{{ domain }}-{{ agent.name }}-agent"
  domain    = "{{ domain }}"
  framework = "{{ framework }}"
  protocols = {{ agent.config.protocols | tojson }}
  role_arn  = aws_iam_role.runtime.arn
  model_id  = "{{ model_id }}"

  container_image       = "${var.ecr_repo_url}:latest"
  cognito_user_pool_id  = var.cognito_user_pool_id
  cognito_app_client_id = aws_cognito_user_pool_client.{{ agent.name }}.id
  allowed_callers       = [{{ agent.allowed_client_refs | join(', ') }}]
{% if agent.callee_endpoint_refs %}

  extra_environment_variables = {
{% for env_key, ref in agent.callee_endpoint_refs.items() %}
    {{ env_key }} = {{ ref }}
{% endfor %}
  }
{% endif %}

  tags = { "eap:agent" = "{{ agent.name }}-agent" }
}
{% if agent.config.memory is defined and agent.config.memory %}

module "memory_{{ agent.name }}" {
  source = "{{ module_source }}//modules/memory?ref={{ module_version }}"

  name        = "{{ domain }}-{{ agent.name }}-memory"
  domain      = "{{ domain }}"
  memory_type = "{{ agent.config.memory.type }}"
  retention   = "{{ agent.config.memory.retention | default('30d') }}"
}
{% endif %}
{% if agent.config.evaluations is defined and agent.config.evaluations %}

module "evaluations_{{ agent.name }}" {
  source = "{{ module_source }}//modules/evaluations?ref={{ module_version }}"

  name       = "{{ domain }}-{{ agent.name }}-evaluations"
  domain     = "{{ domain }}"
  runtime_id = module.runtime_{{ agent.name }}.id
  evaluators = [
{% for ev in agent.config.evaluations.evaluators %}
{% if agent.config.evaluations.thresholds is defined and agent.config.evaluations.thresholds and ev in agent.config.evaluations.thresholds %}
    { name = "{{ ev }}", threshold = {{ agent.config.evaluations.thresholds[ev] }} },
{% else %}
    { name = "{{ ev }}" },
{% endif %}
{% endfor %}
  ]
}
{% endif %}
{% if agent.config.code_interpreter is defined and agent.config.code_interpreter %}

module "code_interpreter_{{ agent.name }}" {
  source = "{{ module_source }}//modules/code-interpreter?ref={{ module_version }}"

  name   = "{{ domain }}-{{ agent.name }}-code-interpreter"
  domain = "{{ domain }}"
}
{% endif %}
{% if agent.config.browser is defined and agent.config.browser %}

module "browser_{{ agent.name }}" {
  source = "{{ module_source }}//modules/browser?ref={{ module_version }}"

  name   = "{{ domain }}-{{ agent.name }}-browser"
  domain = "{{ domain }}"
}
{% endif %}
{% endfor %}
